{
  "api": "jira",
  "note": "Jira Cloud REST v3 and Agile 1.0 (the most used operations). Data Center: /rest/api/2/… with the same paths, search is GET /rest/api/2/search (startAt). Full spec: pass --spec <file> with Atlassian's OpenAPI JSON.",
  "operations": [
    {"id": "searchIssues", "method": "POST", "path": "/rest/api/3/search/jql", "read": true, "tags": "search jql issues find list filter query",
     "summary": "Search issues with JQL; paginated by nextPageToken (client: jira().search)",
     "body": {"jql": "string*", "fields": "[string] — only what you need", "maxResults": "int (≤5000, default 50)", "nextPageToken": "string", "expand": "string (e.g. changelog, renderedFields)"}},
    {"id": "countIssues", "method": "POST", "path": "/rest/api/3/search/approximate-count", "read": true, "tags": "count jql how many number issues",
     "summary": "Approximate number of issues matching JQL (client: jira().count)", "body": {"jql": "string*"}},
    {"id": "getIssue", "method": "GET", "path": "/rest/api/3/issue/{issueIdOrKey}", "tags": "issue ticket story bug read details get",
     "summary": "One issue (client: jira().issue)", "params": {"fields": "string,list", "expand": "renderedFields,changelog,transitions,names", "properties": "string,list"}},
    {"id": "bulkFetchIssues", "method": "POST", "path": "/rest/api/3/issue/bulkfetch", "read": true, "tags": "many issues keys bulk read",
     "summary": "Up to 100 issues by keys or ids in one request", "body": {"issueIdsOrKeys": "[string]*", "fields": "[string]"}},
    {"id": "createIssue", "method": "POST", "path": "/rest/api/3/issue", "tags": "create new issue ticket story bug task add",
     "summary": "Create an issue (write); description is ADF (client: adf(text))",
     "body": {"fields": "{project:{key}*, issuetype:{name|id}*, summary*, description(ADF), assignee:{accountId}, labels:[string], parent:{key}, priority:{name}, customfield_*}"}},
    {"id": "bulkCreateIssues", "method": "POST", "path": "/rest/api/3/issue/bulk", "tags": "create many issues bulk add",
     "summary": "Create up to 50 issues in one request (write)", "body": {"issueUpdates": "[{fields}]*"}},
    {"id": "editIssue", "method": "PUT", "path": "/rest/api/3/issue/{issueIdOrKey}", "tags": "edit update change issue fields summary labels",
     "summary": "Edit issue fields (write)", "params": {"notifyUsers": "bool"}, "body": {"fields": "{field: value}", "update": "{labels:[{add|remove: x}], …}"}},
    {"id": "deleteIssue", "method": "DELETE", "path": "/rest/api/3/issue/{issueIdOrKey}", "tags": "delete remove issue",
     "summary": "Delete an issue (write, irreversible — a human does it)", "params": {"deleteSubtasks": "bool"}},
    {"id": "getTransitions", "method": "GET", "path": "/rest/api/3/issue/{issueIdOrKey}/transitions", "tags": "transitions workflow status move available",
     "summary": "Transitions available for the issue (client: jira().transitions)"},
    {"id": "doTransition", "method": "POST", "path": "/rest/api/3/issue/{issueIdOrKey}/transitions", "tags": "transition move status workflow done in progress",
     "summary": "Move the issue through a transition (write; client: jira().transition(key, name))", "body": {"transition": "{id}*", "fields": "{…}", "update": "{…}"}},
    {"id": "getComments", "method": "GET", "path": "/rest/api/3/issue/{issueIdOrKey}/comment", "tags": "comments discussion read",
     "summary": "Comments, paginated startAt (client: jira().comments)", "params": {"startAt": "int", "maxResults": "int", "orderBy": "created|-created"}},
    {"id": "addComment", "method": "POST", "path": "/rest/api/3/issue/{issueIdOrKey}/comment", "tags": "comment add write reply",
     "summary": "Add a comment (write; body is ADF; client: jira().comment)", "body": {"body": "ADF*", "visibility": "{type: role|group, value}"}},
    {"id": "assignIssue", "method": "PUT", "path": "/rest/api/3/issue/{issueIdOrKey}/assignee", "tags": "assign assignee owner user",
     "summary": "Assign the issue (write)", "body": {"accountId": "string|null*"}},
    {"id": "getChangelog", "method": "GET", "path": "/rest/api/3/issue/{issueIdOrKey}/changelog", "tags": "history changelog changes who when",
     "summary": "Change history, paginated (values)", "params": {"startAt": "int", "maxResults": "int"}},
    {"id": "getWorklogs", "method": "GET", "path": "/rest/api/3/issue/{issueIdOrKey}/worklog", "tags": "worklog time logged spent hours",
     "summary": "Logged work (worklogs)", "params": {"startAt": "int", "maxResults": "int", "startedAfter": "epoch ms"}},
    {"id": "addWorklog", "method": "POST", "path": "/rest/api/3/issue/{issueIdOrKey}/worklog", "tags": "worklog log time spent",
     "summary": "Log work (write)", "body": {"timeSpentSeconds": "int*", "started": "2026-01-31T09:00:00.000+0000", "comment": "ADF"}},
    {"id": "linkIssues", "method": "POST", "path": "/rest/api/3/issueLink", "tags": "link relate blocks duplicates issues",
     "summary": "Link two issues (write)", "body": {"type": "{name: Blocks|Relates|Duplicate}*", "inwardIssue": "{key}*", "outwardIssue": "{key}*"}},
    {"id": "getRemoteLinks", "method": "GET", "path": "/rest/api/3/issue/{issueIdOrKey}/remotelink", "tags": "remote links pull request confluence web",
     "summary": "Remote links of the issue (PRs, pages)"},
    {"id": "createMetaIssueTypes", "method": "GET", "path": "/rest/api/3/issue/createmeta/{projectIdOrKey}/issuetypes", "tags": "create metadata issue types required fields",
     "summary": "Issue types that can be created in a project"},
    {"id": "createMetaFields", "method": "GET", "path": "/rest/api/3/issue/createmeta/{projectIdOrKey}/issuetypes/{issueTypeId}", "tags": "create metadata required fields allowed values",
     "summary": "Fields (required, allowed values) for creating an issue of this type", "params": {"startAt": "int", "maxResults": "int"}},
    {"id": "searchProjects", "method": "GET", "path": "/rest/api/3/project/search", "tags": "projects list find",
     "summary": "Projects, paginated (values)", "params": {"query": "string", "startAt": "int", "maxResults": "int"}},
    {"id": "getProject", "method": "GET", "path": "/rest/api/3/project/{projectIdOrKey}", "tags": "project details lead",
     "summary": "One project"},
    {"id": "getVersions", "method": "GET", "path": "/rest/api/3/project/{projectIdOrKey}/versions", "tags": "versions releases fix version",
     "summary": "Project versions (releases)"},
    {"id": "getComponents", "method": "GET", "path": "/rest/api/3/project/{projectIdOrKey}/components", "tags": "components modules",
     "summary": "Project components"},
    {"id": "getFields", "method": "GET", "path": "/rest/api/3/field", "tags": "fields custom field id customfield names",
     "summary": "All fields with ids (find customfield_NNNNN by name)"},
    {"id": "myself", "method": "GET", "path": "/rest/api/3/myself", "tags": "me current user account check credentials",
     "summary": "The account the token belongs to (a cheap connection check)"},
    {"id": "searchUsers", "method": "GET", "path": "/rest/api/3/user/search", "tags": "users find person accountId email",
     "summary": "Find users (accountId)", "params": {"query": "string*", "maxResults": "int"}},
    {"id": "assignableUsers", "method": "GET", "path": "/rest/api/3/user/assignable/search", "tags": "assignable users who can be assigned",
     "summary": "Users that can be assigned in a project or issue", "params": {"project": "key", "issueKey": "key", "query": "string"}},
    {"id": "getStatuses", "method": "GET", "path": "/rest/api/3/status", "tags": "statuses workflow states names",
     "summary": "All statuses"},
    {"id": "getPriorities", "method": "GET", "path": "/rest/api/3/priority", "tags": "priorities",
     "summary": "All priorities"},
    {"id": "parseJql", "method": "POST", "path": "/rest/api/3/jql/parse", "read": true, "tags": "jql validate parse check query syntax",
     "summary": "Validate JQL queries", "params": {"validation": "strict|warn|none"}, "body": {"queries": "[string]*"}},
    {"id": "getBoards", "method": "GET", "path": "/rest/agile/1.0/board", "tags": "boards scrum kanban agile",
     "summary": "Boards, paginated (values)", "params": {"projectKeyOrId": "string", "type": "scrum|kanban", "name": "string"}},
    {"id": "getSprints", "method": "GET", "path": "/rest/agile/1.0/board/{boardId}/sprint", "tags": "sprints active future closed",
     "summary": "Sprints of a board, paginated (values)", "params": {"state": "active,future,closed"}},
    {"id": "getSprintIssues", "method": "GET", "path": "/rest/agile/1.0/sprint/{sprintId}/issue", "tags": "sprint issues board work",
     "summary": "Issues in a sprint, paginated (issues)", "params": {"jql": "string", "fields": "string,list", "startAt": "int", "maxResults": "int"}},
    {"id": "moveToSprint", "method": "POST", "path": "/rest/agile/1.0/sprint/{sprintId}/issue", "tags": "move issues to sprint plan",
     "summary": "Move up to 50 issues to a sprint (write)", "body": {"issues": "[key]*"}},
    {"id": "getBacklog", "method": "GET", "path": "/rest/agile/1.0/board/{boardId}/backlog", "tags": "backlog board issues",
     "summary": "Backlog issues of a board (issues)", "params": {"jql": "string", "fields": "string,list"}},
    {"id": "getEpicIssues", "method": "GET", "path": "/rest/agile/1.0/epic/{epicIdOrKey}/issue", "tags": "epic children issues",
     "summary": "Issues of an epic (issues); in new projects also JQL parent = KEY", "params": {"fields": "string,list"}}
  ]
}
