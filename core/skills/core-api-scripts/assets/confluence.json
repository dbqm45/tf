{
  "api": "confluence",
  "note": "Confluence Cloud (base https://<site>.atlassian.net/wiki): API v2 for pages and spaces, v1 for CQL search. Data Center: v1 only (/rest/api/content…). Full spec: pass --spec <file> with Atlassian's OpenAPI JSON.",
  "operations": [
    {"id": "searchCql", "method": "GET", "path": "/rest/api/search", "tags": "search cql find pages content text title",
     "summary": "Search content with CQL; results without bodies, paginated by _links.next (client: confluence().search)",
     "params": {"cql": "string* (e.g. space = DEV AND type = page AND text ~ \"payment\")", "limit": "int", "cursor": "string", "excerpt": "highlight|none"}},
    {"id": "getPage", "method": "GET", "path": "/api/v2/pages/{id}", "tags": "page read get body content",
     "summary": "One page with its body (client: confluence().page; text(page) for plain text)", "params": {"body-format": "storage|atlas_doc_format", "version": "int"}},
    {"id": "listPages", "method": "GET", "path": "/api/v2/pages", "tags": "pages list find by title space",
     "summary": "Pages, cursor-paginated (results)", "params": {"space-id": "id,list", "title": "string", "status": "current|draft|archived", "body-format": "storage", "limit": "int (≤250)"}},
    {"id": "spacePages", "method": "GET", "path": "/api/v2/spaces/{id}/pages", "tags": "space pages tree list",
     "summary": "Pages of a space (results)", "params": {"depth": "root|all", "title": "string", "limit": "int"}},
    {"id": "childPages", "method": "GET", "path": "/api/v2/pages/{id}/children", "tags": "children child pages tree subpages",
     "summary": "Child pages of a page (results)", "params": {"limit": "int"}},
    {"id": "listSpaces", "method": "GET", "path": "/api/v2/spaces", "tags": "spaces list keys id",
     "summary": "Spaces (results); the id is needed by v2 page calls", "params": {"keys": "key,list", "type": "global|personal", "limit": "int"}},
    {"id": "getSpace", "method": "GET", "path": "/api/v2/spaces/{id}", "tags": "space details",
     "summary": "One space"},
    {"id": "createPage", "method": "POST", "path": "/api/v2/pages", "tags": "create new page write add document",
     "summary": "Create a page (write)", "body": {"spaceId": "string*", "title": "string*", "parentId": "string", "status": "current|draft", "body": "{representation: storage, value: XHTML}*"}},
    {"id": "updatePage", "method": "PUT", "path": "/api/v2/pages/{id}", "tags": "update edit page write change",
     "summary": "Update a page (write; version.number = current + 1)", "body": {"id": "string*", "status": "current*", "title": "string*", "body": "{representation, value}*", "version": "{number*, message}"}},
    {"id": "deletePage", "method": "DELETE", "path": "/api/v2/pages/{id}", "tags": "delete remove page trash",
     "summary": "Move a page to the trash (write — a human does it)"},
    {"id": "pageComments", "method": "GET", "path": "/api/v2/pages/{id}/footer-comments", "tags": "comments page discussion read",
     "summary": "Footer comments of a page (results)", "params": {"body-format": "storage", "limit": "int"}},
    {"id": "addComment", "method": "POST", "path": "/api/v2/footer-comments", "tags": "comment add write page",
     "summary": "Add a footer comment (write)", "body": {"pageId": "string*", "body": "{representation: storage, value}*"}},
    {"id": "pageLabels", "method": "GET", "path": "/api/v2/pages/{id}/labels", "tags": "labels tags page",
     "summary": "Labels of a page (results)"},
    {"id": "pageAttachments", "method": "GET", "path": "/api/v2/pages/{id}/attachments", "tags": "attachments files page download",
     "summary": "Attachments of a page (results; downloadLink)"},
    {"id": "pageVersions", "method": "GET", "path": "/api/v2/pages/{id}/versions", "tags": "versions history page who changed",
     "summary": "Versions of a page (results)"},
    {"id": "getContentV1", "method": "GET", "path": "/rest/api/content/{id}", "tags": "page content read data center v1 body",
     "summary": "One page, API v1 (Data Center and Cloud)", "params": {"expand": "body.storage,version,space,ancestors"}},
    {"id": "findContentV1", "method": "GET", "path": "/rest/api/content", "tags": "find page by title space key v1 data center",
     "summary": "Find pages by space key and title, API v1 (results)", "params": {"spaceKey": "key", "title": "string", "expand": "version", "limit": "int"}},
    {"id": "currentUser", "method": "GET", "path": "/rest/api/user/current", "tags": "me current user check credentials",
     "summary": "The account the token belongs to (a cheap connection check)"}
  ]
}
