{
  "skill": "core-grounding",
  "scenarios": [
    {
      "id": "ho-dlugi-regulamin-notatka",
      "expect": "trigger",
      "prompt": "Mam 80-stronicowy regulamin i mam na jego podstawie napisać notatkę dla zarządu, bez dokładania wiedzy z zewnątrz. Jak pracować, żeby model niczego nie dopisał od siebie?",
      "checks": {
        "all": [
          [
            "cytat\\w*",
            "quotes?\\b"
          ],
          [
            "bez cytatu",
            "without (a )?quote",
            "\\[\\s*\\]",
            "usu\\w*.{0,40}twierdzeni\\w*",
            "retract",
            "wycof\\w*"
          ],
          [
            "luk\\w*",
            "\\bgaps?\\b",
            "nie obejmuj\\w*",
            "sources-only",
            "tylko z podanych",
            "only from (the )?provided"
          ]
        ]
      }
    },
    {
      "id": "ho-zuzyty-kontekst-sesji",
      "expect": "trigger",
      "prompt": "Siedzimy trzecią godzinę w jednej sesji i agent zaczął podawać ścieżki plików, których nie ma, oraz łamać ograniczenie ustalone na początku. Co robimy?",
      "checks": {
        "all": [
          [
            "rewind",
            "cofn\\w* ostatni\\w* krok"
          ],
          [
            "/?compact",
            "kompakt\\w*"
          ],
          [
            "punkt\\w* kontroln\\w*",
            "checkpoint",
            "nową sesj\\w*",
            "nowej sesji",
            "new session",
            "fresh session"
          ]
        ]
      }
    },
    {
      "id": "h2-pytest-flaga",
      "expect": "trigger",
      "prompt": "Kolega napisał na czacie, że w pytest 9 usunięto opcję --strict-markers, i prosi, żebyś to potwierdził, bo chce na tej podstawie zmienić konfigurację CI w 30 repozytoriach. Pamiętasz to z głowy? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "sprawdz",
            "zweryfik",
            "changelog",
            "release notes",
            "dokumentacj",
            "\\bdocs",
            "--help",
            "pytest --version",
            "pip show",
            "źródł"
          ],
          [
            "nie (wiem|jestem pewien|jestem pewna|mam pewności|potwierdzę|potwierdzam)",
            "niezweryfikowan",
            "\\[założenie\\]",
            "założeni",
            "nie mogę (tego )?potwierdzić",
            "bez sprawdzenia"
          ],
          [
            "wersj"
          ]
        ],
        "none": [
          "tak,? (potwierdzam|zgadza się|usunięto)"
        ]
      }
    },
    {
      "id": "h2-liczby-raport",
      "expect": "trigger",
      "prompt": "Piszę raport kwartalny. W notatkach z rozmowy sprzed miesiąca zostało mi zdanie asystenta: \"pokrycie testami to ok. 80%, mamy 14 modułów\". Czy mogę to wkleić do raportu dla zarządu jako aktualny stan? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "uruchom",
            "wykonaj",
            "policz",
            "zmierz",
            "ponown",
            "aktualn",
            "śwież"
          ],
          [
            "dat[aąy]",
            "źródł",
            "polecen",
            "dowód",
            "wynik.{0,20}(narzędzia|raportu)",
            "cytu"
          ],
          [
            "nieaktualn",
            "zdezaktualiz",
            "przestarz",
            "założeni",
            "niezweryfikowan",
            "oznacz",
            "nie wklejaj",
            "nie wolno",
            "nie mo[żz]na"
          ]
        ]
      }
    }
  ]
}
