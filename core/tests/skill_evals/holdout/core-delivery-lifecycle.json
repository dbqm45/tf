        "all": [
          [
            "zastan\\w*",
            "found\\s*/?\\s*expected",
            "oczekiwan\\w*\\s*/\\s*zastan"
          ],
          [
            "dostosuj i kontynuuj",
            "adjust and continue",
            "stop i popraw\\w* plan",
            "popraw\\w* plan"
          ],
          [
            "odstępstw\\w*",
            "deviations?",
            "ADAPT"
          ]
        ],
        "none": [
          "dokręc\\w* kod (dalej|kolejnymi)"
        ]
      }
    },
    {
      "id": "ho-warunek-konca-kroku",
      "expect": "trigger",
      "prompt": "Mam długi krok implementacji i chcę, żeby sesja sama się kończyła, gdy robota jest gotowa. Jak sformułować warunek końca, żeby nie opierał się na słowie agenta, i co zrobić po jego spełnieniu?",
      "checks": {
        "all": [
