  "scenarios": [
    {
      "id": "ho-zmiana-kontraktu-w-kroku",
      "expect": "trigger",
      "prompt": "Agent w połowie kroku wdrożenia zauważył, że modelu danych zakładanego w planie nie ma w kodzie, a poprawka ruszy kilkanaście modułów zamiast trzech plików. Ma po prostu dociągać kod kolejnymi poleceniami?",
