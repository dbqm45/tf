{
  "skill": "core-grounding",
  "scenarios": [
    {
      "id": "falszywa-opcja-postgres",
      "expect": "trigger",
      "prompt": "Kolega twierdzi, że w PostgreSQL 17 jest opcja auto_index_advisor = on w postgresql.conf, która sama zakłada brakujące indeksy. Czy to prawda i jak ją włączyć? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "nie (istnieje|ma takiej|ma opcji|znalaz)",
            "nie jest (standardow|wbudowan)",
            "niezweryfikowan",
            "nie potwierdz",
            "nie ma w"
          ],
          [
            "dokumentacj",
            "SHOW ALL",
            "pg_settings",
            "pg_file_settings",
            "źródł",
            "--help",
            "sprawdź"
          ]
        ],
        "none": [
          "auto_index_advisor\\s*=\\s*on[^\\n]{0,80}(włącza|uruchomi|wystarczy)"
        ]
      }
    },
    {
      "id": "agent-zmysla-wersje",
      "expect": "trigger",
      "prompt": "Agent w poprzedniej sesji podał mi wersje bibliotek i flagi CLI, z których połowa nie istniała. Jak ustawić pracę, żeby nie zmyślał? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "sprawdz",
            "weryfik",
            "--help",
            "npm view"
          ],
          [
            "nie wiem",
            "niezweryfikowan",
            "założeni",
            "oznacz"
          ],
          [
            "kontekst",
            "nowa sesj",
            "/clear",
            "/compact",
            "punkt kontrolny"
          ]
        ]
      }
    },
    {
      "id": "wynik-skryptu-to-twierdzenie",
      "expect": "trigger",
      "prompt": "Skrypt fabryki wypisał, że w repo jest jeden cykl importów obejmujący 242 pliki, i chcę to wpisać do raportu jako fakt. Czy mogę po prostu przepisać liczbę z wyniku narzędzia? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "twierdzeni|sprawdź|zweryfikuj"
          ],
          [
            "największ|losow|próbk|jedno miejsce"
          ],
          [
            "plik:linia|w kodzie|przeczytaj"
          ]
        ]
      }
    },
    {
      "id": "zmiany-node",
      "expect": "no-trigger",
      "neighbor": "core-source-research",
      "prompt": "Zbierz z ostatniego miesiąca, co społeczność zgłasza o problemach po aktualizacji do Node.js 24, z datami i źródłami."
    },
    {
      "id": "liczby-w-raporcie-o-kodzie",
      "expect": "trigger",
      "prompt": "Agent w raporcie z analizy napisał, że metoda calculateFee jest wywoływana dokładnie w 4 miejscach i tylko z modułu billing, a interfejs PaymentGateway ma 54 metody. Na tej podstawie mamy zaplanować refaktor. Jak to zweryfikować, zanim w to uwierzymy? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "ast-grep",
            "LSP",
            "find references",
            "znajdź odwołania",
            "kompilator",
            "narzędzi\\w* strukturaln"
          ],
          [
            "\\brg\\b",
            "ripgrep",
            "grep"
          ],
          [
            "zero",
            "brak trafień",
            "0 wynik",
            "pust\\w* wynik"
          ]
        ]
      }
    },
    {
      "id": "streszczenie-umowy-sla",
      "expect": "trigger",
      "prompt": "Mam 60-stronicową umowę SLA z dostawcą chmury i mam przygotować dla klienta jednostronicowe podsumowanie zobowiązań dostawcy. Jak to zrobić, żeby nie dopisać niczego, czego w umowie nie ma?",
      "checks": {
        "all": [
          [
            "cytat\\w*",
            "dosłown\\w*",
            "quote"
          ],
          [
            "\\[\\s*\\]",
            "bez cytatu",
            "usu\\w*.{0,40}twierdzeni\\w*",
            "wycof\\w*"
          ],
          [
            "luk\\w*",
            "tylko z (podanych|umowy|materiał)",
            "nie (wynika|obejmuj)\\w*"
          ]
        ]
      }
    },
    {
      "id": "agent-lata-wokol-testu",
      "expect": "trigger",
      "prompt": "Agent od rana robi migrację modułu płatności. Od godziny powtarza ustalenia jako nowe odkrycia i dopisuje kolejne łatki wokół tego samego czerwonego testu. Dać mu jeszcze jedną szansę czy coś zmienić?",
      "checks": {
        "all": [
          [
            "/compact",
            "kompakt\\w*"
          ],
          [
            "/rewind",
            "cofn\\w*",
            "/clear",
            "now\\w* sesj\\w*"
          ],
          [
            "punkt\\w* kontroln\\w*",
            "dwa sygnał\\w*",
            "sygnał\\w* zużyt\\w*",
            "zużyt\\w* kontekst\\w*"
          ]
        ]
      }
    },
    {
      "id": "gen-grounding-1",
      "expect": "trigger",
      "prompt": "Asystent napisał mi, że ta biblioteka ma flagę --fast-mode od wersji 3.2. Skąd mam wiedzieć, że to prawda, a nie wymysł? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "sprawdź\\w*|zweryfik\\w*"
          ],
          [
            "dokumentac\\w*|changelog|--help|źródł\\w*|repozytori\\w*"
          ],
          [
            "wersj\\w*|dat\\w*"
          ]
        ]
      }
    },
    {
      "id": "gen-grounding-2",
      "expect": "trigger",
      "prompt": "Kiedy asystent powinien przyznać, że czegoś nie wie, zamiast zgadywać? Mam wrażenie, że zawsze odpowiada pewnym tonem, nawet jak strzela. Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "nie wiem"
          ],
          [
            "sprawdz\\w*|źródł\\w*|niezweryfikowan\\w*|założeni\\w*"
          ]
        ]
      }
    },
    {
      "id": "gen-grounding-3",
      "expect": "trigger",
      "prompt": "Zapytałem o datę wydania i limit zapytań w API zewnętrznego dostawcy, dostałem konkretne liczby. Jak szybko to zweryfikować, zanim wpiszę je do dokumentacji dla klienta? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "źródł\\w* pierwotn\\w*|oficjaln\\w* dokumentac\\w*|dokumentac\\w* (dostawcy|api)"
          ],
          [
            "dat\\w*|z datą|kiedy sprawdz"
          ],
          [
            "niezweryfikowan\\w*|oznacz\\w*"
          ]
        ]
      }
    },
    {
      "id": "gen-grounding-4",
      "expect": "trigger",
      "prompt": "Wrzuciłem 200-stronicową specyfikację i poprosiłem o podsumowanie wymagań. Odpowiedź wygląda składnie, ale boję się, że część dopisał od siebie. Jak to sprawdzić? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "cytat\\w*|stron\\w*|odwołani\\w*|plik:linia|fragment\\w*"
          ],
          [
            "sprawdź\\w*|porównaj\\w*|zweryfik\\w*"
          ]
        ]
      }
    },
    {
      "id": "gen-grounding-5",
      "expect": "trigger",
      "prompt": "Pracuję z asystentem od rana, rozmowa jest już strasznie długa i zaczął mylić nazwy plików, które sam wcześniej stworzył, i wymyślać funkcje, których nie ma. Co z tym zrobić? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "kontekst\\w*|długi\\w* rozmow\\w*|zapełni\\w*"
          ],
          [
            "nowa sesj\\w*|/compact|kompakt\\w*|punkt kontroln\\w*|podsumowani\\w*"
          ],
          [
            "sprawdź\\w*|przeczytaj\\w*|plik\\w*|zweryfik\\w*"
          ]
        ]
      }
    }
  ]
