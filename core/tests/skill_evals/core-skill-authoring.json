    {
      "id": "slaby-skill",
      "expect": "trigger",
      "prompt": "Napisałem skill, którego opis brzmi „Pomaga z dokumentami”, a SKILL.md ma 900 linii samych zasad. Co poprawić, żeby działał dobrze? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "Użyj",
