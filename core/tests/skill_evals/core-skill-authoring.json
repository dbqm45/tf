      "expect": "trigger",
      "prompt": "Chcę dodać do skilla skrypt w scripts/, który liczy metryki z kodu, a agenci mają brać z niego liczby do raportów. Co musi się stać, zanim wepnę go do SKILL.md? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "TDD|najpierw test|czerwon"
          ],
          [
            "wzorc|wzorzec|prawdziw\\w* repo|niezależn"
          ],
          [
            "agent\\w* nie (weryfikuj|sprawdz)|bez weryfikacji|ufa"
          ]
