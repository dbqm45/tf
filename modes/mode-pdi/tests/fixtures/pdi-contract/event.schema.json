          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "run": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "description": "Identyfikator przebiegu (0.15.0): ten sam w run.started, run.progress i run.finished jednego przebiegu, żeby odbiorca połączył je w jedną kartę."
        },
        "started_by": {
          "$ref": "#/$defs/actor"
        },
        "activity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Co agent robi teraz, zwykłymi słowami (0.15.0); bez treści promptów."
        }
      }
    },
    "decision_recorded": {
      "type": "object",
      "additionalProperties": false,
      "description": "Decyzja podjęta w aplikacji nadawcy (np. zamknięcie pytania w ci_for_sdlc, decyzja D-A2) do zapisu w rejestrze pdi. Decyzja człowieka ma drafted_by i przy szkicu AI draft_edited; decyzja automatu ma automation i nie ma draft_edited. Od 0.16.0 każda aplikacja suity publikuje tak swoje decyzje (D1); origin daje pochodzenie i klucz idempotencji.",
      "required": [
        "decision_type",
        "ref",
        "statement",
        "decided_by",
        "drafted_by"
      ],
      "properties": {
        "decision_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Czego dotyczy decyzja w aplikacji nadawcy, np. PAY-12/COV-001."
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "description": "Pochodzenie decyzji podjętej w innej aplikacji suity (D1, od 0.16.0): kto jest jej właścicielem i gdzie leży oryginał. Klucz idempotencji: app + scope + local_id. Brak pola = decyzja podjęta w DI Decision (pdi).",
          "required": [
            "app",
            "scope",
            "local_id"
          ],
          "properties": {
            "app": {
              "type": "string",
              "enum": [
                "pdi",
                "tf",
                "ci_for_sdlc",
                "shipscope"
              ],
              "description": "Aplikacja-właściciel decyzji; te same wartości co source zdarzenia."
            },
            "scope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Gdzie local_id jest jednoznaczny: repo (owner/name), przestrzeń DI Definition, projekt."
            },
            "local_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Identyfikator decyzji u właściciela, np. D-012, CHG-12/D1, PAY-12/COV-001."
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Plik z decyzją w repo właściciela, np. docs/project/decisions.md."
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$",
              "description": "Commit, w którym zapisano tę wersję decyzji."
            },
            "url": {
              "type": "string",
              "pattern": "^https://",
              "description": "Strona decyzji u właściciela."
            }
          }
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "Strona pozycji w aplikacji nadawcy."
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "product",
            "technical",
            "process",
            "triage",
            "intent",
            "gate",
            "other"
          ]
        },
        "decided_by": {
          "type": "string",
          "minLength": 1
        },
        "drafted_by": {
          "type": "string",
          "enum": [
            "ai",
            "human"
          ]
        },
        "draft_edited": {
          "type": "boolean",
          "description": "Czy człowiek zmienił szkic AI (odrzucenie albo ponowne otwarcie to też zmiana)."
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "Dosłowny cytat ze źródła."
              },
              "source_url": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "automation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level"
          ],
          "properties": {
            "level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "rule": {
              "type": "string",
              "minLength": 1
            },
            "veto_until": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "level": {
                    "const": 2
                  }
                },
                "required": [
                  "level"
                ]
              },
              "then": {
                "required": [
                  "veto_until"
                ]
              }
            }
          ]
        },
        "supersedes": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "DEC zastępowanej decyzji tego samego nadawcy i tego samego ref."
        },
        "change": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "CHG"
        },
        "problem": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "PRB"
        },
        "reversibility": {
          "type": "string",
          "enum": [
            "local",
            "broad",
            "one_way"
          ],
          "description": "Odwracalność decyzji (0.19.0, N2; plan budowy suity §3b): `local` — łatwa do cofnięcia, dotyczy jednego miejsca, agent może zdecydować i zapisać; `broad` — łatwa do cofnięcia, ale szeroka, agent proponuje, człowiek akceptuje; `one_way` — trudna do cofnięcia (wydanie na PROD, model danych i migracja, uprawnienia, publiczny kontrakt API, koszt), rozstrzyga decydent przed pracą, która od niej zależy. `local` i `broad` to „łatwa do cofnięcia” z §3b, `one_way` — „trudna”."
        },
        "provisional": {
          "type": "boolean",
          "description": "Decyzja tymczasowa (0.19.0, N2): przyjęta bez decydenta — opcja rekomendowana, z którą agent idzie dalej, albo opcja domyślna po terminie pytania — do potwierdzenia albo zastąpienia przez decydenta. Tylko dla decyzji łatwej do cofnięcia: przy `reversibility: one_way` niedozwolona."
        }
      },
      "not": {
        "required": [
          "automation",
          "draft_edited"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provisional": {
                "const": true
              }
            },
            "required": [
              "provisional"
            ]
          },
          "then": {
            "not": {
              "properties": {
                "reversibility": {
                  "const": "one_way"
                }
              },
              "required": [
                "reversibility"
              ]
            }
          }
        }
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ],
      "description": "Kto uruchomił przebieg (0.15.0, DI Team: pole „Started by”). Inna osoba niż ta, która decyduje na bramce (`decided_by`). Od 0.18.0 także agent (DI4): wtedy `id` i `owner` są wymagane.",
