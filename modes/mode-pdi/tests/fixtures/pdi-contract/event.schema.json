        },
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "automation",
            "agent"
          ],
          "description": "`automation`: przebieg uruchomił harmonogram albo inny automat, nie człowiek; `agent` (0.18.0): agent z kontem w usłudze tożsamości suity (DI4), np. persona fabryki uruchamiająca kolejny przebieg."
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "Dla `kind: agent` (0.18.0): `sub` człowieka odpowiedzialnego za agenta w usłudze tożsamości suity (DI4)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "id",
              "owner"
            ]
          }
        }
      ]
    },
