{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dbqm45/pdi/contract/event.schema.json",
  "title": "Zdarzenie (kontrakt suity 0.19.0)",
  "description": "Koperta zdarzenia wymienianego między pdi, tf, ci_for_sdlc i ShipScope; treść (payload) zależy od typu.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "occurred_at",
    "source",
    "contract_version",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unikalny identyfikator zdarzenia (np. UUID) — do deduplikacji u odbiorcy."
    },
    "type": {
      "type": "string",
      "enum": [
        "problem.accepted",
        "gate.requested",
        "gate.decided",
        "readiness.changed",
        "feature.released",
        "metric.breached",
        "decision.basis_invalidated",
        "release.stage_changed",
        "decision.proposed",
        "decision.auto_applied",
        "decision.vetoed",
        "run.progress",
        "decision.recorded",
        "run.started",
        "run.finished"
      ]
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "source": {
      "type": "string",
      "enum": [
        "pdi",
        "tf",
        "ci_for_sdlc",
        "shipscope"
      ]
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "problem.accepted"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/problem_accepted"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "gate.requested"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/gate_requested"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "gate.decided"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/gate_decided"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "readiness.changed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/readiness_changed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "feature.released"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/feature_released"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "metric.breached"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/metric_breached"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "decision.basis_invalidated"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/decision_basis_invalidated"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "release.stage_changed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/release_stage_changed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "decision.proposed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/decision_proposed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "decision.auto_applied"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/decision_auto_applied"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "decision.vetoed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/decision_vetoed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.progress"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/run_progress"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "decision.recorded"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/decision_recorded"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.started"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/run_started"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.finished"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/run_finished"
          }
        }
      }
    }
  ],
  "$defs": {
    "problem_accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem",
        "change",
        "decision"
      ],
      "properties": {
        "problem": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "PRB"
        },
        "change": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "CHG"
        },
        "decision": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "DEC"
        },
        "project": {
          "type": "string"
        }
      }
    },
    "gate_requested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change",
        "gate",
        "summary"
      ],
      "properties": {
        "change": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "CHG"
        },
        "gate": {
          "type": "string",
          "minLength": 1,
          "description": "B1–B6 albo nazwa bramki, np. design-review, approve-for-implementation."
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targets": {
          "type": "object",
          "description": "Cele zmiany z release.yaml (Z7b-1a, 0.12.0): tf dokleja je do prośby o B3, żeby człowiek widział, co zatwierdza; po `approved` pdi zapisuje ich kopię w stanie zmiany. Opcjonalne — bramki inne niż B3 nie muszą ich podawać. Kształt: `release_plan.schema.json#/$defs/targets` (`coverage`, `mutation`, `performance`, `evaluations`)."
        },
        "second_review": {
          "type": "object",
          "description": "Streszczenie drugiego przeglądu artefaktu innym modelem (N1, 0.13.0): tf dokleja je do prośby o B2 i B3, żeby człowiek widział, czy przegląd się odbył. Opcjonalne. `status: unavailable` z `reason` oznacza brak przeglądu, nigdy cichą zgodę. Pola nieznane odbiorca pomija.",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "description": "`ok` — przegląd się odbył; `unavailable` — nie (powód w `reason`)."
            },
            "reason": {
              "type": "string"
            },
            "provider": {
              "type": [
                "string",
                "null"
              ]
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "same_vendor": {
              "type": "boolean"
            },
            "cost_usd": {
              "type": "number",
              "minimum": 0
            },
            "findings_total": {
              "type": "integer",
              "minimum": 0
            },
            "blocking": {
              "type": "integer",
              "minimum": 0
            },
            "contradictions": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "reversibility": {
          "type": "string",
          "enum": [
            "local",
            "broad",
            "one_way"
          ],
          "description": "Odwracalność decyzji (0.19.0, N2; plan budowy suity §3b): `local` — łatwa do cofnięcia, dotyczy jednego miejsca, agent może zdecydować i zapisać; `broad` — łatwa do cofnięcia, ale szeroka, agent proponuje, człowiek akceptuje; `one_way` — trudna do cofnięcia (wydanie na PROD, model danych i migracja, uprawnienia, publiczny kontrakt API, koszt), rozstrzyga decydent przed pracą, która od niej zależy. `local` i `broad` to „łatwa do cofnięcia” z §3b, `one_way` — „trudna”."
        },
        "closes_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "description": "Termin zamknięcia pytania (0.19.0, N2; §3b pkt 5), UTC. Brak = termin z operating modelu odbiorcy (OM1 w pdi). Pytanie wygasa, decyzja nie."
        },
        "default_option": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Opcja domyślna po terminie (0.19.0, N2; §3b pkt 6): przy decyzji łatwej do cofnięcia obowiązuje po `closes_at` bez dodatkowego kroku, jako decyzja tymczasowa (`provisional`); przy `one_way` decydent musi ją potwierdzić."
        },
        "asked": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/actor"
          },
          "description": "Pytani o zdanie (0.19.0, N2; §3b pkt 2–3): 2–4 wskazane osoby (albo agenci), które dostają powiadomienie z terminem. Doradzają; decyduje decydent. Reszta zespołu nie jest tu wymieniana."
        }
      }
    },
    "gate_decided": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change",
        "gate",
        "outcome",
        "decision"
      ],
      "properties": {
        "change": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "CHG"
        },
        "gate": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "enum": [
            "approved",
            "changes_requested",
            "rejected"
          ]
        },
        "decision": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "DEC"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "readiness_changed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change",
        "readiness"
      ],
      "properties": {
        "change": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "CHG"
        },
        "readiness": {
          "type": "string",
          "enum": [
            "ready",
            "not_ready",
            "drift"
          ]
        },
        "open_questions": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "type": "string"
        },
        "targets_status": {
          "$ref": "#/$defs/targets_status"
        }
      }
    },
    "targets_status": {
      "type": "object",
      "additionalProperties": false,
      "description": "Stan celów zmiany (release_plan.targets) przed B4 (Z7b-1b, kontrakt 0.16.0): wypełnia ci_for_sdlc, czyta pdi. Brak pola = cele nie zostały zbadane. `details` nazywa cele po kolei, żeby człowiek zobaczył, który próg jest niespełniony.",
      "required": [
        "overall",
        "checked_at"
      ],
      "properties": {
        "overall": {
          "type": "string",
          "enum": [
            "met",
            "not_met",
            "unknown"
          ]
        },
        "checked_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "coverage",
                  "mutation",
                  "performance",
                  "evaluation",
                  "other"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "met",
                  "not_met",
                  "unknown"
                ]
              },
              "observed": {
                "type": "string",
                "minLength": 1,
                "description": "Wynik jak tekst (`86.4%`, `412ms`)."
              },
              "required": {
                "type": "string",
                "minLength": 1,
                "description": "Próg jak w planie (`>= 90%`, `<= 400ms`)."
              },
              "note": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "feature_released": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change",
        "released_at"
      ],
      "properties": {
        "change": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "CHG"
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
            "description": "TSK"
          }
        },
        "version": {
          "type": "string"
        },
        "released_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "environment": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "release": {
          "type": "string",
          "pattern": "^R[0-9]+$",
          "description": "Wydana linia; R1 wydane = MVP u ludzi."
        }
      }
    },
    "metric_breached": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "value",
        "threshold"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "threshold": {
          "type": "number"
        },
        "window": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "change": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "CHG"
        },
        "diagnosis": {
          "type": "string"
        }
      }
    },
    "decision_basis_invalidated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "assumption",
        "signal",
        "attention_level"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "DEC"
        },
        "assumption": {
          "type": "string",
          "minLength": 1,
          "description": "Założenie nośne, którego dotyczy sygnał."
        },
        "signal": {
          "type": "string",
          "minLength": 1,
          "description": "Co się stało (zgodne z invalidated_if)."
        },
        "signal_source": {
          "type": "string",
          "description": "ID zdarzenia, zgłoszenia albo URL źródła."
        },
        "attention_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Poziom uwagi 0–3 (dokument 05)."
        }
      }
    },
    "release_stage_changed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change",
        "flag",
        "to_stage"
      ],
      "properties": {
        "change": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "CHG"
        },
        "release": {
          "type": "string",
          "pattern": "^R[0-9]+$"
        },
        "flag": {
          "type": "string",
          "minLength": 1
        },
        "from_stage": {
          "type": "string"
        },
        "to_stage": {
          "type": "string",
          "minLength": 1
        },
        "rollout": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Procent udostępnienia po zmianie."
        }
      }
    },
    "decision_proposed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_type",
        "level",
        "summary"
      ],
      "properties": {
        "item": {
          "type": "string",
          "description": "ID pozycji w skrzynce."
        },
        "decision_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "type": "string"
        },
        "veto_until": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "change": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "CHG"
        },
        "problem": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "PRB"
        },
        "reversibility": {
          "type": "string",
          "enum": [
            "local",
            "broad",
            "one_way"
          ],
          "description": "Odwracalność decyzji (0.19.0, N2; plan budowy suity §3b): `local` — łatwa do cofnięcia, dotyczy jednego miejsca, agent może zdecydować i zapisać; `broad` — łatwa do cofnięcia, ale szeroka, agent proponuje, człowiek akceptuje; `one_way` — trudna do cofnięcia (wydanie na PROD, model danych i migracja, uprawnienia, publiczny kontrakt API, koszt), rozstrzyga decydent przed pracą, która od niej zależy. `local` i `broad` to „łatwa do cofnięcia” z §3b, `one_way` — „trudna”."
        },
        "closes_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "description": "Termin zamknięcia pytania (0.19.0, N2; §3b pkt 5), UTC. Brak = termin z operating modelu odbiorcy (OM1 w pdi). Pytanie wygasa, decyzja nie."
        },
        "default_option": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Opcja domyślna po terminie (0.19.0, N2; §3b pkt 6): przy decyzji łatwej do cofnięcia obowiązuje po `closes_at` bez dodatkowego kroku, jako decyzja tymczasowa (`provisional`); przy `one_way` decydent musi ją potwierdzić."
        },
        "asked": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/actor"
          },
          "description": "Pytani o zdanie (0.19.0, N2; §3b pkt 2–3): 2–4 wskazane osoby (albo agenci), które dostają powiadomienie z terminem. Doradzają; decyduje decydent. Reszta zespołu nie jest tu wymieniana."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "level": {
                "const": 2
              }
            },
            "required": [
              "level"
            ]
          },
          "then": {
            "required": [
              "veto_until"
            ]
          }
        }
      ]
    },
    "decision_auto_applied": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "decision_type",
        "level"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "DEC zapisana przez automat"
        },
        "decision_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "rule": {
          "type": "string"
        },
        "change": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "CHG"
        }
      }
    },
    "decision_vetoed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_type",
        "vetoed_by"
      ],
      "properties": {
