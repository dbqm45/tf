        },
        "reason": {
          "type": "string"
        },
        "change": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "CHG"
        }
      }
    },
    "run_progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "status"
      ],
      "properties": {
        "change": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "CHG"
        },
        "task": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "TSK"
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "slice": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "started",
            "in_progress",
            "waiting_gate",
            "done",
            "failed"
          ]
