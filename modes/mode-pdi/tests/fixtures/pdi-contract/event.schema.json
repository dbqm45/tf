            "schedule"
          ],
          "description": "`manual`: sesja uruchomiona ręcznie (terminal, IDE); `pdi`: faza zlecona przez DI Decision; `schedule`: harmonogram."
        },
        "agent": {
          "type": "string",
          "minLength": 1,
          "description": "Persona albo agent, który pracuje (np. nazwa persony fabryki)."
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identyfikator agenta (`sub` jego konta) w usłudze tożsamości suity (0.18.0, DI4), gdy agent ma konto; `agent` zostaje nazwą persony do wyświetlenia."
        },
        "repo": {
          "type": "string",
          "pattern": "^[\\w.-]+/[\\w.-]+$",
          "description": "Repozytorium owner/name."
