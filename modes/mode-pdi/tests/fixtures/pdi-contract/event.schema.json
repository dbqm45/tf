          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "description": "Identyfikator przebiegu (0.15.0): ten sam w run.started, run.progress i run.finished jednego przebiegu, żeby odbiorca połączył je w jedną kartę."
        },
        "change": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "CHG"
        },
