{
  "permissions": {
    "allow": [
      "Bash(python3 .claude/skills/pdi-decisions/scripts/decision_record.py *)",
      "Bash(python3 .claude/skills/pdi-decisions/scripts/phase_run.py *)",
      "Bash(python3 .claude/skills/pdi-decisions/scripts/design_check.py *)",
      "Bash(python3 .claude/skills/pdi-decisions/scripts/triage_pdi.py *)",
      "Bash(python3 .claude/skills/pdi-decisions/scripts/metric_watch.py *)",
      "Bash(python3 .claude/skills/pdi-decisions/scripts/second_review.py *)",
      "Bash(python3 .claude/skills/pdi-decisions/scripts/pr_loop.py *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/run_report.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/run_report.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/run_report.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
