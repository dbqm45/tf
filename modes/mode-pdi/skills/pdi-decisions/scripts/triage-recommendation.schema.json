{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dbqm45/tf/modes/mode-pdi/triage-recommendation.schema.json",
  "title": "Rekomendacja triażu zgłoszenia PRB (tf dla pdi, F3) — propozycja do kontraktu pdi",
  "description": "Wynik triage_pdi.py recommend. Stan i pola jak w problem.schema.json kontraktu pdi 0.4.0 (R7), żeby pdi przepisało je do zgłoszenia bez tłumaczenia; tf_state i tf_labels z tabeli mapowania w contract/README.md. Decyzję podejmuje człowiek w pdi; zmianę (change) tworzy pdi po przyjęciu.",
  "type": "object",
  "additionalProperties": false,
  "required": ["problem", "contract_version", "recommended_status", "tf_state", "rationale", "drafted_by"],
  "properties": {
    "problem": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "recommended_status": {"type": "string", "enum": ["clarifying", "accepted", "rejected", "parked", "duplicate"]},
    "tf_state": {"type": "string", "enum": ["needs-triage", "needs-info", "ready-for-agent", "ready-for-human", "wontfix"]},
    "tf_labels": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "category": {"type": "string", "enum": ["bug", "enhancement"]},
    "rationale": {"type": "string", "minLength": 1},
    "questions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "executor": {"type": "string", "enum": ["agent", "human"]},
    "brief": {"type": "string", "minLength": 1},
    "rejection_reason": {"type": "string", "enum": ["out_of_strategy", "works_as_designed", "cost_disproportionate", "already_exists", "out_of_scope_recorded", "other"]},
    "rejection_note": {"type": "string"},
    "out_of_scope_file": {"type": "string", "pattern": "^\\.out-of-scope/.+\\.md$"},
    "return_when": {"type": "string", "minLength": 1},
    "duplicate_of": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "epistemic_status"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "source_url": {"type": "string"},
          "epistemic_status": {"type": "string", "enum": ["observation", "interpretation", "hypothesis", "ai_inference"]}
        }
      }
    },
    "drafted_by": {"type": "string", "enum": ["ai", "human"]}
  },
  "allOf": [
    {"if": {"properties": {"recommended_status": {"const": "clarifying"}}}, "then": {"required": ["questions"], "properties": {"tf_state": {"const": "needs-info"}}}},
    {"if": {"properties": {"recommended_status": {"const": "accepted"}}}, "then": {"required": ["brief", "executor"]}},
    {"if": {"properties": {"recommended_status": {"const": "rejected"}}}, "then": {"required": ["rejection_reason"], "properties": {"tf_state": {"const": "wontfix"}}}},
    {"if": {"properties": {"rejection_reason": {"const": "out_of_scope_recorded"}}, "required": ["rejection_reason"]}, "then": {"required": ["out_of_scope_file"]}},
    {"if": {"properties": {"recommended_status": {"const": "parked"}}}, "then": {"required": ["return_when"], "properties": {"tf_state": {"const": "needs-triage"}}}},
    {"if": {"properties": {"recommended_status": {"const": "duplicate"}}}, "then": {"required": ["duplicate_of"], "properties": {"tf_state": {"const": "wontfix"}}}}
  ]
}
