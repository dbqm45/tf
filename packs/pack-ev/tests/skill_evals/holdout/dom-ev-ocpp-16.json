{
  "skill": "dom-ev-ocpp-16",
  "scenarios": [
    {
      "id": "ho-ocpp16-offline-rozliczenie",
      "expect": "trigger",
      "prompt": "Ładowarka straciła sieć w trakcie sesji, a po powrocie przysłała StartTransaction z meterStart 12000 i StopTransaction z meterStop 30340. Ile kWh rozliczyć i skąd ma być transactionId, skoro sesja zaczęła się offline?",
      "checks": {
        "all": [
          [
            "18[ ,.]?340\\s*Wh",
            "18[,.]34\\s*kWh",
            "18[,.]3\\d?\\s*kWh"
          ],
          [
            "transactionId.{0,80}(CSMS|Central System|backend|serwer|nadaje)",
            "(CSMS|Central System|backend)\\w*.{0,60}nadaje.{0,30}transactionId",
            "(CSMS|Central System).{0,40}assign"
          ],
          [
            "czas\\w* odbioru",
            "time of receipt",
            "received (at|time)",
            "zegar\\w*.{0,80}(błęd|korekt|synchroniz)",
            "clock",
            "currentTime",
            "bufor\\w+.{0,80}(kolejn|timestamp|czas)"
          ]
        ]
      }
    },
    {
      "id": "ho-ocpp16-tolerancyjna-walidacja",
      "expect": "trigger",
      "prompt": "Jeden model ładowarek wysyła w payloadzie dodatkowe pole spoza schematu. Nasz CSMS waliduje ściśle, odrzuca ramkę, a ładowarka ponawia ją bez końca. Jak to rozwiązać?",
      "checks": {
        "all": [
          [
            "toleran\\w+",
            "lenient"
          ],
          [
            "alert\\w*.{0,60}(model|producent|vendor)",
            "per model",
            "(model|producent)\\w*.{0,40}alert"
          ],
          [
            "FormationViolation",
            "PropertyConstraintViolation",
            "OccurenceConstraintViolation",
            "TypeConstraintViolation",
            "CALLERROR",
            "InternalError"
          ]
        ]
      }
    },
    {
      "id": "ho-ocpp16-ponowiony-start",
      "expect": "trigger",
      "prompt": "Po zerwaniu połączenia ładowarka wysłała ponownie ten sam StartTransaction z tym samym identyfikatorem wiadomości i w CSMS powstały dwie transakcje. Jak powinien to obsłużyć backend?",
      "checks": {
        "all": [
          [
            "messageId",
            "identyfikator\\w* wiadomości"
          ],
          [
            "chargePointId",
            "identyfikator\\w* ładowark\\w*",
            "pary? .{0,40}ładowark"
          ],
          [
            "t(ę|a) sam\\w* odpowied\\w*",
            "same response",
            "bez ponown\\w* skutk\\w*",
            "nie twórz\\w* drugiej",
            "idempoten\\w*"
          ]
        ]
      }
    },
    {
      "id": "h2-boot-pending",
      "expect": "trigger",
      "prompt": "Nowa ładowarka po starcie wysyła BootNotification, a nasz system odpowiada ramką [3,\"a1\",{\"status\":\"Pending\",\"currentTime\":\"2026-11-02T08:00:00Z\",\"interval\":60}]. Instalator pyta, czy ładowarka ma od razu raportować stany złączy i dopuścić ładowanie, skoro \"połączenie działa\". Jak powinna się zachować i co dalej? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "ponow.{0,40}BootNotification",
            "BootNotification.{0,60}ponow",
            "retry",
            "powtarza.{0,30}Boot"
          ],
          [
            "60 ?s",
            "60 sekund",
            "interval",
            "interwał"
          ],
          [
            "nie.{0,80}(StatusNotification|Authorize|StartTransaction|transakcj|innych (wiadomości|komunikatów|żądań))",
            "wstrzym",
            "czekać",
            "oczekiwa"
          ]
        ]
      }
    },
    {
      "id": "h2-offline-sesje",
      "expect": "trigger",
      "prompt": "Ładowarka w parkingu podziemnym straciła łączność na 3 godziny w nocy i w tym czasie zrealizowała dwie sesje autoryzowane lokalnie. Po powrocie sieci w naszym systemie obie sesje mają godzinę startu 06:41, czyli moment odbioru wiadomości, a jedna jest zdublowana. Jak to powinno działać po stronie ładowarki i systemu centralnego? Odpowiedz zwięźle.",
      "checks": {
        "all": [
