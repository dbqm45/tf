  "scenarios": [
    {
      "id": "zdrowie-ekonomiki",
      "expect": "trigger",
      "prompt": "SaaS B2B: MRR 200 tys. zł, churn klientów 3% miesięcznie, CAC 4000 zł, średni przychód na klienta 250 zł miesięcznie, marża brutto 80%. Czy ta ekonomia jest zdrowa? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "LTV ?[:/] ?CAC",
            "LTV do CAC"
          ],
          [
            "1[,.][67]"
          ],
          [
            "zwrot\\w* CAC",
            "CAC payback",
            "okres zwrotu"
          ],
          [
            "20 mies\\w*"
          ],
          [
            "churn\\w*",
            "odejś\\w*"
          ]
        ],
        "none": [
          "LTV ?[:/] ?CAC[^\\n]{0,40}\\b(5|6|7|8)[,.]\\d"
        ]
      }
    },
    {
