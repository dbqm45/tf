{
  "skill": "ops-dependency-upgrades",
  "scenarios": [
    {
      "id": "spring-boot-java",
      "expect": "trigger",
      "prompt": "W pom.xml mamy Spring Boot 2.7 i Javę 11; dostaliśmy zadanie podniesienia do Spring Boot 3.5 i Javy 21. Jak to zaplanować i przeprowadzić bezpiecznie? Odpowiedz zwięźle.",
      "files": {
        "pom.xml": "<project>\n  <parent>\n    <groupId>org.springframework.boot</groupId>\n    <artifactId>spring-boot-starter-parent</artifactId>\n    <version>2.7.18</version>\n  </parent>\n  <properties>\n    <java.version>11</java.version>\n  </properties>\n</project>\n"
      },
      "checks": {
        "all": [
          [
            "OpenRewrite",
            "rewrite"
          ],
          [
            "jakarta"
          ],
          [
            "krok",
            "etap",
            "po kolei",
            "najpierw"
          ],
          [
            "11 ?→ ?17|17[^.]{0,40}warunek|najpierw (na |do )?(Jav\\w* )?17"
          ],
          [
            "dryRun|dry-run|testy charakteryzuj|ostrzeże\\w*[^.]{0,30}deprecj"
          ]
        ]
      }
    },
    {
      "id": "zalew-pr",
      "expect": "trigger",
      "prompt": "Mamy 40 repozytoriów i od roku nikt nie aktualizuje w nich zależności. Jak ustawić regularne aktualizacje w Renovate albo Dependabocie, żeby nie zalały nas pull requesty? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "group",
            "grup"
          ],
          [
            "automerge",
            "automatyczn\\w* (scal|merge)"
          ],
          [
            "schedule",
            "harmonogram",
            "raz w tygodniu",
            "weekly",
            "interval"
          ],
          [
            "0\\.x|łatk\\w* bezpiecze\\w*[^.]{0,60}(bez karencji|poza harmonogram)|oba narzędzia|zdublowan"
          ]
        ]
      }
    },
    {
      "id": "bez-plikow-uv",
      "expect": "trigger",
      "prompt": "W projekcie na uv chcemy podnosić zależności po jednej paczce i najpierw zobaczyć, co jest nieaktualne. Jak to zrobić i jak sprawdzić, że nic się nie zepsuło? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "--outdated"
          ],
          [
            "--upgrade-package",
            "-P "
          ],
          [
            "test"
          ],
          [
            "stan\\w* .?przed|punkt\\w* wyjścia|DeprecationWarning|ostrzeże\\w* o przestarzał|testy charakteryzuj"
          ]
        ]
      }
    },
    {
      "id": "przejeta-paczka",
      "expect": "no-trigger",
      "neighbor": "ops-supply-chain-security",
      "prompt": "Wczoraj ogłoszono, że paczka npm, której używamy, została przejęta i wydano złośliwą wersję. Jak sprawdzić w lockfile, czy nas to dotknęło?"
    }
  ]
}
