    {
      "id": "zachowanie-per-najemca",
      "expect": "trigger",
      "prompt": "Jeden duży klient naszego SaaS chce innej reguły zatwierdzania zamówień niż wszyscy pozostali. Jak to zrobić bez forka kodu dla tego klienta? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "fork|gałęz\\w*|kopi\\w*"
          ],
          [
            "konfigur\\w*|flag\\w*|polityk\\w*|handler\\w*|strategi\\w*"
          ],
          [
            "właściciel\\w*.{0,40}dat\\w* usunięci",
            "dat\\w* usunięcia",
            "\\bADR\\b"
          ],
          [
            "handler\\w* (komendy )?per (najemc|tenant)",
            "osobn\\w+ (plan|kontekst)"
          ]
        ]
      }
