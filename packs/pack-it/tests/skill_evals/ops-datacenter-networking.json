      "expect": "trigger",
      "prompt": "Mamy dodać nowy tenant z VXLAN i EVPN do produkcyjnej fabryki. Jak przygotować i przeprowadzić zmianę, żeby nie wywrócić sieci? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          ["netbox|source of truth|źródł[oa] prawdy"],
          ["okno (zmian|serwisow)|change window|maintenance window"],
          ["rollback|wycofani|plan awaryjny"],
          ["ci\\b|pipeline|dry.?run|emulac|symulac|batfish|containerlab|lab"]
        ],
        "none": ["bezpośrednio na produkcji bez"]
      }
    },
    {
      "id": "host-dns-curl",
