{
  "skill": "proc-issue-triage",
  "scenarios": [
    {
      "id": "zgloszenie-bledu",
      "expect": "trigger",
      "prompt": "Dostaliśmy w repo zgłoszenie błędu od zewnętrznego użytkownika: „eksport CSV się wysypuje”. Jak je przejrzeć i jak oznaczyć, zanim zlecimy naprawę agentowi? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "needs-info",
            "needs-triage",
            "ready-for-agent"
          ],
          [
            "odtwórz",
            "odtworz",
            "reprodu"
          ],
          [
            "brief"
          ]
        ]
      }
    },
    {
      "id": "odrzucona-funkcja",
      "expect": "trigger",
      "prompt": "Ktoś zewnętrzny prosi o tryb ciemny w naszej bibliotece, a już raz to odrzuciliśmy. Jak to obsłużyć, żeby nie spierać się za każdym razem od nowa? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "out-of-scope"
          ],
          [
            "wontfix"
          ],
          [
            "jeden plik na pojęcie",
            "na pojęcie",
            "pojęci"
          ]
        ]
      }
    },
    {
      "id": "doslowna-prosba-a-potrzeba",
      "expect": "trigger",
      "prompt": "Użytkownik zgłosił w issue: „Dodajcie przycisk do eksportu wszystkich zamówień do CSV”. Jak to ocenić w triażu, zanim przygotujemy brief? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "potrzeb\\w*",
            "problem\\w*",
            "cel\\w*",
            "co chce osiągnąć",
            "po co"
          ],
          [
            "dosłown\\w*",
            "rozwiązani\\w*[^\\n]{0,40}(zamiast|nie) problem",
            "XY"
          ],
          [
            "pytani\\w*",
            "zapytaj",
            "needs-info"
          ],
          [
            "istniej\\w*",
            "już (jest|można)",
            "obejści\\w*",
            "raport\\w*"
          ]
        ]
      }
    },
    {
      "id": "wlasny-sprint",
      "expect": "no-trigger",
      "prompt": "Jak zaplanować własny sprint zespołu: cel sprintu, wybór elementów z backlogu i pojemność zespołu? Odpowiedz zwięźle.",
      "neighbor": "proc-agile"
    }
  ]
}
