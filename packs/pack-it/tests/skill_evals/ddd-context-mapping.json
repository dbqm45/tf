{
  "skill": "ddd-context-mapping",
  "scenarios": [
    {
      "id": "acl-platnosci",
      "expect": "trigger",
      "prompt": "Mamy kontekst Sprzedaż (core) i zewnętrzny system płatności z własnym, kiepskim modelem. Jak ułożyć relację między nimi na mapie kontekstów, żeby obcy model nie przeciekał do naszego? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "ACL",
            "anti-corruption",
            "antykorupcyjn"
          ],
          [
            "conformist",
            "konformi"
          ],
          [
            "upstream",
            "downstream"
          ],
          [
            "conformi\\w*[^.]{0,120}(język|core|rdzen|rdzeń)",
            "(core|rdzen|rdzeń|język)[^.]{0,80}conformi"
          ],
          [
            "dependency-cruiser|no-restricted-imports|ArchUnit",
            "\\brg -l\\b|grep[^.]{0,60}adapter",
            "context-map\\.md",
            "connascence"
          ]
        ]
      }
    },
    {
      "id": "event-carried-state",
      "expect": "trigger",
      "prompt": "Zamówienia mają publikować zdarzenie dla Magazynu i Rozliczeń, które potrzebują lokalnej kopii danych, żeby działać, gdy Zamówienia leżą. Co powinno być w zdarzeniu i jak odbiorcy mają je obsługiwać? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "event-carried",
            "carried state",
            "state transfer",
            "przenosz\\w* stan"
          ],
          [
            "idempoten"
          ],
          [
            "wersj\\w* schemat|numer\\w* (wersji|sekwencji)|kolejno"
          ],
          [
            "spójnoś\\w* ostateczn|eventual\\w* consisten",
            "jedyn\\w* właściciel|właściciel\\w*[^.]{0,40}danych|źródł\\w* prawdy|source of truth"
          ]
        ]
      }
    },
    {
      "id": "acl-wobec-biblioteki",
      "expect": "trigger",
      "accept": [
        "ddd-legacy-modernization"
      ],
      "prompt": "Czy Anti-Corruption Layer ma sens wobec zwykłej biblioteki npm, a nie innego kontekstu? Jak sprawdzić, że izolacja naprawdę działa i nie rozjedzie się za pół roku? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "port|adapter"
          ],
          [
            "tylko w katalogu adaptera|wyłącznie.{0,40}adapter|\\brg\\b|grep"
          ],
          [
            "dependency-cruiser|no-restricted-imports|ArchUnit|lint"
          ],
          [
            "serwerow\\w*[^.]{0,80}(klient|przeglądark|bundle|paczk)",
            "obiekt\\w* wartości[^.]{0,80}(jedyn|zna kształt)"
          ]
        ]
      }
    },
    {
      "id": "granice-kontekstow",
      "expect": "no-trigger",
      "prompt": "Mamy duży system sprzedażowy. Według jakich kryteriów wyznaczyć granice bounded contextów i po czym poznać, że dwa pojęcia powinny trafić do osobnych kontekstów? Odpowiedz zwięźle.",
      "neighbor": "ddd-strategic-analysis"
    },
    {
      "id": "tozsamosc-pojecia-i-rzeczy",
      "expect": "trigger",
      "prompt": "Ten sam dostawca występuje w CRM, ERP i systemie zakupów pod różnymi ID, a „przychód” każdy dział liczy inaczej. Jak uporządkować tożsamość między kontekstami bez centralnej bazy wszystkiego? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          ["pojęci\\w+", "definicj\\w+ (metryk|pojęć)", "słownik\\w*"],
          ["klucz\\w* biznesow\\w+", "reguł\\w+ wybijania", "jeden identyfikator", "mapowani\\w+ kluczy"],
          ["dane zostają u właścicieli", "u właścicieli", "wspólna (jest )?tylko tożsamość", "bez kopiowania danych"],
          ["bibliotek\\w+", "specyfikacj\\w+", "nie w jednym narzędziu"]
        ]
      }
    }
  ]
