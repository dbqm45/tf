    {
      "id": "audyt-zaawansowany-format",
      "expect": "trigger",
      "prompt": "Zrób audyt bezpieczeństwa naszej aplikacji webowej (Next.js + API w Node) przed wydaniem, łącznie z rzeczami zaawansowanymi, nie tylko XSS i SQL injection. W jakiej kolejności to przejść i jak ma wyglądać raport? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "Werdykt"
          ],
          [
            "plik:linia",
            "\\w+\\.\\w+:\\d+"
          ],
          [
            "cache",
            "smuggling",
            "prototype pollution",
            "zanieczyszcz\\w* prototyp\\w*",
            "wyścig\\w*",
            "race",
            "mass assignment",
            "CORS"
          ],
          [
            "CWE-\\d+"
          ]
        ]
      }
