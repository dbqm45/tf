      "prompt": "Dodajemy podgląd linków: serwer pobiera URL podany przez użytkownika i wyciąga tytuł strony. Kolega blokuje URL-e zawierające 'localhost' i '127.0.0.1'. Czy to wystarczy, a jeśli nie, jak to zrobić porządnie? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "169\\.254\\.169\\.254",
            "metadan\\w*",
            "metadata"
          ],
          [
            "DNS rebinding",
            "rozwiąz\\w*[^\\n]{0,80}(adres|IP)",
            "po rozwiązaniu",
            "przypi\\w* (adres|IP)",
            "pin\\w*"
          ],
          [
            "przekierow\\w*",
            "redirect",
            "3\\d\\d"
          ],
          [
            "0x7f|2130706433|\\[::1?\\]|::ffff|IPv6|dziesiętn\\w*|ósemkow\\w*|szesnastkow\\w*"
          ]
        ],
        "none": [
          "(to|blokada) wystarczy"
        ]
      }
    },
    {
