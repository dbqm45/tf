      "expect": "trigger",
      "prompt": "Na stronie wyników front czyta location.hash i wstawia go przez innerHTML jako nagłówek „Wyniki dla: …”. Backend escapuje wszystko, a przed aplikacją stoi WAF. Czy to wystarczy? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "DOM\\w*[- ]?(based|XSS)",
            "XSS\\w* (w|oparty na) DOM",
            "DOM XSS"
          ],
          [
