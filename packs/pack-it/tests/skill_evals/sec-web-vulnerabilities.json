      "expect": "trigger",
      "prompt": "Zgłoszenie od użytkownika: wysłał koledze link https://app.example.com/account/settings/avatar.png, kolega go otworzył, a potem zgłaszający pod tym samym adresem zobaczył stronę ustawień kolegi z jego e-mailem i adresem. Aplikacja stoi za CDN. Jak to możliwe i jak to naprawić? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "cache deception",
            "oszuk\\w* (cache|pamięci podręcznej)",
            "deception"
          ],
          [
            "no-store",
            "private",
            "Cache-Control"
          ],
          [
            "rozszerzen\\w*",
            "sufiks\\w*",
            "404",
            "ścisł\\w* (routing|dopasowan)",
            "ścież\\w* statyczn\\w*",
            "allowlist\\w*"
