            "fragment\\w*[^\\n]{0,80}(nie (jest )?wysyłan|nie trafia|nie dociera)",
            "(#|hash)[^\\n]{0,80}nie (jest )?(wysyłan|przesyłan)"
          ],
          [
            "textContent",
            "innerText",
            "sanitiz\\w*",
            "DOMPurify"
          ]
        ],
        "none": [
