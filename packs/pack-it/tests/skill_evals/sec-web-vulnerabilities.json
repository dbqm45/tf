{
  "skill": "sec-web-vulnerabilities",
  "scenarios": [
    {
      "id": "idor-w-endpoincie-faktur",
      "expect": "trigger",
      "prompt": "Aplikację zrobiliśmy szybko z pomocą AI. Endpoint w Express: app.get('/api/invoices/:id', requireLogin, async (req, res) => res.json(await Invoice.findById(req.params.id))). Logowanie działa. Czy coś tu jest nie tak i jak to sprawdzić testem? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "IDOR",
            "BOLA",
            "CWE-639",
            "cudz\\w* faktur",
            "inn\\w* użytkownik\\w*"
          ],
          [
            "właściciel\\w*",
            "owner",
            "userId",
            "user_id",
            "tenant",
            "najemc\\w*",
            "organizacj\\w*"
          ],
          [
            "test\\w*[^\\n]{0,160}(drugi|inn\\w*|obc\\w*) (użytkownik|kont|najemc)",
            "(403|404)[^\\n]{0,120}test",
            "test\\w*[^\\n]{0,120}(403|404)"
          ]
        ],
        "none": [
          "(wystarczy|wystarcza)[^\\n]{0,40}(requireLogin|logowani)"
        ]
      }
    },
    {
      "id": "ssrf-podglad-linku-obejscia",
