{
  "skill": "be-api-design",
  "scenarios": [
    {
      "id": "ho-limit-ruchu-partnera",
      "expect": "trigger",
      "prompt": "Udostępniamy API partnerom i jeden z nich zalał nas żądaniami. Jak ograniczyć ruch i co ma dostać klient po przekroczeniu?",
      "checks": {
        "all": [
          [
            "token bucket",
            "sliding window",
            "okno przesuwne",
            "leaky bucket",
            "wiadro"
          ],
          [
            "Retry-After"
          ],
          [
            "RateLimit-Policy",
            "X-RateLimit",
            "\\bRateLimit\\b",
            "kwot\\w*.{0,40}(inn|osobn)",
            "quota"
          ]
        ]
      }
    },
    {
      "id": "ho-import-czesciowy",
      "expect": "trigger",
      "prompt": "Klient wysyła nam przez API plik z 5000 produktów, z których część jest błędna. Poprawne mają wejść, a on ma dostać informację, które poprawić. Jak to wystawić?",
      "checks": {
        "all": [
          [
            "\\b207\\b",
            "multi-?status"
          ],
          [
            "per rekord",
            "osobno dla (każdego )?rekord\\w*",
            "wynik\\w* (dla|na) (każdego )?rekord\\w*",
            "per record",
            "each record"
          ],
          [
            "\\b202\\b",
            "NDJSON",
            "json-seq",
            "Location",
            "limit\\w* (liczby )?rekord\\w*"
          ]
        ]
      }
    },
    {
      "id": "ho-api-rownolegla-edycja",
      "expect": "trigger",
      "prompt": "Dwóch operatorów edytuje w panelu ten sam produkt i drugi zapis po cichu nadpisuje zmiany pierwszego. Jak to rozwiązać na poziomie API?",
      "checks": {
        "all": [
          [
            "ETag"
          ],
          [
            "If-Match"
          ],
          [
            "\\b412\\b",
            "Precondition Failed"
          ]
        ]
      }
    },
    {
      "id": "h2-platnosc-retry",
      "expect": "trigger",
      "prompt": "Aplikacja mobilna wysyła POST /payments. Przy słabym zasięgu klient łapie timeout, ponawia żądanie i dwa razy mieliśmy podwójne obciążenie karty. Jak zaprojektować endpoint, żeby ponowienia były bezpieczne? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "Idempotency.Key",
            "klucz.{0,15}idempoten",
            "idempoten"
          ],
          [
            "zapisa",
            "przechow",
            "zwr[óo]c.{0,40}(poprzedni|zapisan|tę samą|ten sam)",
            "deduplik",
            "unikaln.{0,20}(indeks|ograniczen)"
          ],
          [
            "409",
            "422",
            "inn[ey].{0,20}(payload|treś|ciał|dane)",
            "TTL",
            "wygas",
            "retencj"
          ]
        ]
      }
    },
    {
      "id": "h2-lista-przewijanie",
      "expect": "trigger",
      "prompt": "Endpoint GET /orders?page=300&per_page=50 działa coraz wolniej, a klienci skarżą się, że przy przewijaniu listy raz widzą te same zamówienia dwukrotnie, a raz jakieś giną, bo w tle spływają nowe. Co zmienić w projekcie dzielenia wyników na porcje? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "kursor",
            "cursor",
            "keyset",
            "seek"
          ],
          [
            "next_cursor",
            "nast[eę]pn.{0,25}(kursor|strona|link|porcj)",
            "opaque",
            "nieprzezroczy",
            "zakodowan",
            "base64",
            "Link"
          ],
          [
            "unikaln",
            "tie.?break",
            "dodatkow.{0,25}(klucz|kolumn|pole)",
            "\\bid\\b",
            "stabiln.{0,25}(sortowan|kolejno)",
            "ORDER BY"
          ]
        ]
      }
    }
  ]
}
