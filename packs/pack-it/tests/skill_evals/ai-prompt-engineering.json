{
  "skill": "ai-prompt-engineering",
  "scenarios": [
    {
      "id": "prompt-dlugie-dokumenty",
      "expect": "trigger",
      "prompt": "Wklejam do promptu 8 długich umów (ok. 100 tys. tokenów) i pytam o klauzule kar umownych, ale model gubi szczegóły. Jak ułożyć taki prompt? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "na (górze|początku|początek)",
            "przed pytaniem",
            "dokumenty (na )?pierwsz\\w+",
            "najpierw dokument"
          ],
          [
            "pytani\\w+ (na|u) (końc|dole)",
            "na końcu",
            "query at the end",
            "pytanie na koniec"
          ],
          [
            "<document",
            "tag\\w* XML",
            "znacznik\\w* XML",
            "XML"
          ],
          [
            "cytat\\w*",
            "wyciągnij fragmenty",
            "quotes",
            "najpierw wypisz"
          ],
          [
            "(popraw|lepsz|zysk)[^.]{0,40}30 ?%",
            "30 ?%[^.]{0,40}(popraw|lepsz)",
            "jedn\\w+ (rzecz|zmian\\w+) na raz"
          ]
        ],
        "none": [
          "pytanie przed dokumentami",
          "zawsze wrzuć wszystko jednym zdaniem"
        ]
      }
    },
    {
