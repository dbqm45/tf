      "checks": {
        "all": [
          [
            "stabiln\\w+ (prefiks|początek|część)",
            "prefiks",
            "część stał\\w+ (na )?(początku|górze)",
            "zmienn\\w+ (na )?(końcu|dole|po)"
          ],
          [
            "cache",
            "pamięć podręczn",
            "prompt caching"
          ],
          [
            "wersj\\w+",
            "rejestr promptów",
            "prompt registry",
            "szablon\\w*"
          ],
          [
            "ewaluacj\\w+",
            "zestaw\\w* regresyjn",
            "evals?",
            "regresj\\w+"
          ],
          [
            "przypię\\w+ model",
            "pinned model",
            "jedn\\w+ (rzecz|zmian\\w+) na raz",
            "SemVer"
          ]
        ],
        "none": [
          "data i imię na początku są w porządku",
          "nie wersjonuj promptów"
        ]
      }
    },
    {
      "id": "prefill-migracja-modelu",
      "expect": "trigger",
      "prompt": "Przesiadamy się na nowszy model Claude. Nasze prompty używają prefillu odpowiedzi do wymuszania JSON-a, wielkich liter CRITICAL i ręcznego budżetu myślenia. Co trzeba zmienić? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "prefill\\w*",
            "wstępn\\w+ wypełnieni",
            "częściow\\w+ wiadomoś"
