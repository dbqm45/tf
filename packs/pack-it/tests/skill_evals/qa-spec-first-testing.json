{
  "skill": "qa-spec-first-testing",
  "scenarios": [
    {
      "id": "testy-z-kodu",
      "expect": "trigger",
      "prompt": "Mam metodę calculateDiscount i chcę, żeby AI wygenerowało do niej testy jednostkowe na podstawie samego kodu. Czy to dobry pomysł? Skąd brać oczekiwane wartości? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "lustrzan",
            "mirror",
            "powiel",
            "koduj",
            "utrwal"
          ],
          [
            "wyroczn",
            "oracle",
            "spoza kodu",
            "źródł\\w* niezależn"
          ],
          [
            "clean-room",
            "clean room",
            "nie widz.{0,25}implementacji",
            "bez dostępu do (kodu|implementacji)",
            "przed (napisaniem )?(kodu|implementacj)",
            "specyfikacj\\w* bez implementacji",
            "bez implementacji",
            "bez kodu (metody|implementac|produkcyjn)",
            "nie (pokazuj|dawaj)\\w* (mu )?kodu"
          ]
        ]
