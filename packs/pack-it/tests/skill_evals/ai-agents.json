{
  "skill": "ai-agents",
  "scenarios": [
    {
      "id": "agent-czy-workflow",
      "expect": "trigger",
      "prompt": "Chcemy zautomatyzować obsługę zgłoszeń reklamacyjnych: klasyfikacja, pobranie danych zamówienia, szkic odpowiedzi, sprawdzenie szkicu. Zespół chce od razu budować autonomicznego agenta wieloagentowego. Czy to dobry pomysł? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "prompt chaining",
            "łańcuch\\w* prompt",
            "workflow",
            "przepływ\\w* (z góry|zdefiniowan|predefiniowan)"
          ],
          [
            "routing",
            "evaluator-optimizer",
            "orchestrator-workers",
            "parallelization",
            "równoległ"
          ],
          [
            "najprostsz\\w* (rozwiązani|wariant)",
            "dopiero (gdy|jeśli)",
            "nie (jest )?potrzebn\\w* agent",
            "koszt\\w* (i )?(opóźnien|latency)"
          ]
        ],
        "none": [
          "(zawsze|od razu) (buduj|zbuduj) (system )?wieloagentow"
        ]
      }
    },
    {
