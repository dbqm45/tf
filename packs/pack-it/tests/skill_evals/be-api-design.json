{
  "skill": "be-api-design",
  "scenarios": [
    {
      "id": "idempotencja-platnosci",
      "expect": "trigger",
      "prompt": "Endpoint POST /payments inicjuje przelew, a klient mobilny po timeoucie ponawia żądanie. Jak zapewnić, że nie powstaną dwa przelewy i co zwracać przy ponowieniu? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "Idempotency-Key",
            "klucz\\w* idempoten"
          ],
          [
            "409",
            "422",
            "ta sama odpowied",
            "zapisan\\w* (odpowied|wynik)",
            "stored response",
            "same response",
            "replay"
          ],
          [
            "inn\\w* (body|treś|payload|dane|ciał)",
            "różn\\w* (body|treś|payload|ciał)",
            "hash\\w* (ciał|body|żądani)",
            "request_hash",
            "mismatch",
            "fingerprint",
            "skrót"
          ],
          [
            "Problem Details",
            "9457"
          ]
        ]
      }
    },
    {
      "id": "paginacja-kolekcji",
      "expect": "trigger",
      "prompt": "Wystawiamy GET /orders z milionami rekordów i wieloma filtrami. Jak zrobić paginację i sortowanie, żeby nikt nie obciążył bazy? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "kursor",
            "cursor",
            "keyset"
          ],
          [
            "limit\\w*.*(maks|max|twardy|górn|serwer)",
            "(maks|max|twardy|górn)\\w* limit",
            "hard limit"
          ],
          [
            "whitelist",
            "biał\\w* list",
            "allowlist",
            "dozwolon\\w* pol",
            "lista dozwolon"
          ]
        ]
      }
    },
    {
      "id": "indeksy-orders",
      "expect": "no-trigger",
      "prompt": "Jakie indeksy złożone założyć w PostgreSQL na tabeli orders pod zapytania po customer_id i created_at?",
      "neighbor": "be-database"
    },
    {
      "id": "komenda-jako-zasob",
      "expect": "trigger",
      "prompt": "Mamy operację 'zatwierdź reklamację', która nie pasuje do CRUD na zasobie reklamacji. Jak ją wystawić w API HTTP w duchu REST? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "POST"
          ],
          [
            "zasób\\w*|dokument\\w*"
          ],
          [
            "komend\\w*|akcj\\w*|decyzj\\w*"
          ],
          [
            "revocation",
            "kolejn\\w* komend",
            "nie używaj `?DELETE",
            "zamiast `?DELETE"
          ],
          [
            "If-Match",
            "\\b412\\b",
            "\\b202\\b"
          ]
        ]
      }
    },
    {
      "id": "eksport-csv-duzy",
      "expect": "trigger",
      "prompt": "Użytkownicy chcą eksportować do CSV listę klientów (do 2 mln wierszy) z bieżącymi filtrami. Dziś endpoint generuje plik w trakcie żądania i po 30 sekundach pada na timeout. Jak zaprojektować eksport po stronie API? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "w tle",
            "asynchron\\w*",
            "zadani\\w* (w tle|eksportu)",
            "\\b202\\b",
            "job\\w*",
            "kolejk\\w*"
          ],
          [
            "status\\w*",
            "powiadom\\w*",
            "postęp\\w*",
            "polling",
            "webhook"
          ],
          [
            "wygas\\w*",
            "podpisan\\w* (URL|link|adres)",
            "presigned",
            "signed URL",
            "czas\\w* ważności"
          ],
          [
            "uprawnie\\w*",
            "autoryzac\\w*",
            "te same filtr\\w*"
          ],
          [
            "dan\\w* osobow\\w*",
            "PII",
            "RODO",
            "kolumn\\w*"
          ],
          [
            "wstrzykiw\\w* formuł",
            "formula injection",
            "CSV injection",
            "znak\\w* =",
            "zaczyna\\w* się od (=|znaku)"
          ]
