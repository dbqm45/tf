{
  "skill": "ux-visual-design",
  "scenarios": [
    {
      "id": "kontrast-szary-tekst",
      "expect": "trigger",
      "prompt": "Projektantka dała szary tekst pomocniczy #8A8A8A na białym tle, a przyciski mają jasnoniebieski kolor #3B82F6 z białym napisem. Czy kontrast jest wystarczający i co poprawić? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          ["4[,.]5\\s*:\\s*1"],
          ["3[,.]4\\d?", "3[,.]6\\d?", "nie (spełnia|przechodzi)", "za niski", "niewystarczając"],
          ["1\\.4\\.3", "1\\.4\\.11", "3\\s*:\\s*1"],
          ["tryb\\w* ciemn", "ciemn\\w+ (motyw|palet)", "dark mode", "kolor\\w* marki", "1\\.4\\.11"]
        ],
        "none": ["kontrast (jest )?(wystarczając|w normie|spełnia)\\w* (dla|przy) #8A8A8A"]
      }
    },
    {
      "id": "ruch-panel-boczny",
      "expect": "trigger",
      "prompt": "Robię animację wysuwanego panelu bocznego i okna modalnego w aplikacji roboczej. Jak dobrać czas trwania i krzywą oraz co zrobić dla osób, które nie znoszą ruchu na ekranie? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          ["200|250|300"],
          ["ease-out", "decelerat", "cubic-bezier", "wyhamow"],
          ["prefers-reduced-motion", "reduced motion"],
          ["przenikani", "fade", "opacity", "zamiast (przesuni|ruchu)"],
          ["70\\s*[–-]\\s*80\\s*%", "(najwyżej|maks\\w*|do|≤) ?500\\s*ms", "ruch\\w*[^.]{0,20}(musi |ma )mie\\w* cel", "ruch musi mieć cel"]
        ],
        "none": ["(1000|1500|2000)\\s*ms"]
      }
    },
    {
      "id": "przeglad-wdrozenia-vs-figma",
      "expect": "trigger",
      "prompt": "Programista wdrożył ekran z Figmy, ale odstępy i fonty wyglądają inaczej niż w projekcie. Jak zrobić rzetelny przegląd zgodności wizualnej wdrożenia z projektem? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          ["nakład", "overlay", "diff", "porówna\\w* (obok|zrzut|screenshot)"],
          ["token"],
          ["tolerancj", "±", "1\\s*px", "2\\s*px", "próg"],
          ["stan\\w*", "hover", "fokus", "ciemn"],
          ["(wraca|trafia|przekaż)\\w* do projektant", "poniżej tolerancji nie", "nie (wobec )?gust", "wobec celu i progu"]
        ]
      }
    },
    {
      "id": "css-siatka-kart",
      "expect": "no-trigger",
      "prompt": "Jak w CSS zrobić siatkę kart, która sama zmienia liczbę kolumn przy zmianie szerokości, bez żadnych media queries?",
      "neighbor": "fe-css"
    }
  ]
}
